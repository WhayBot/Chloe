OPENROUTER_API_KEY=
# ID model dari openrouter.ai/models (pilih varian :free untuk model gratis, format: vendor/model:free)
MODEL_PRIMARY=
# Daftar model cadangan dipisah koma (misal: vendor/model-b:free,vendor/model-c:free)
MODEL_FALLBACKS=
# Batas token keluaran model (default 1200).
# PENTING: Model reasoning/thinking (misal Qwen 2.5/3.8, DeepSeek R1) memproduksi token penalaran internal
# yang memakan kuota ini. Jika disetel terlalu kecil (misal 400), token habis untuk berpikir
# sehingga balasan teks menjadi kosong atau terpotong di tengah JSON (finish_reason=length).
MODEL_MAX_TOKENS=1200
# Intensitas reasoning untuk OpenRouter (opsional: low, medium, high, none, atau kosongkan)
MODEL_REASONING=
# Kebijakan data OpenRouter: allow | deny (kosong = default OpenRouter)
# 'deny' membatasi request hanya ke penyedia yang tidak memakai prompt untuk melatih model
MODEL_DATA_COLLECTION=
# Zero Data Retention (ZDR): 1 = batasi hanya ke endpoint yang menjamin Zero Data Retention, 0 = nonaktif
MODEL_ZDR=0
CHARACTER_NAME=Chloe
BOT_NUMBER=
# PERINGATAN: debug/trace bisa mencetak nomor telepon dan metadata pesan ke konsol.
# Hanya untuk debugging sementara; kembalikan ke silent setelah selesai.
BAILEYS_LOG_LEVEL=silent
USERS_FILE=./users.json
DAILY_LIMIT_PER_USER=15
MODEL_DAILY_BUDGET=40
TZ=Asia/Jakarta
DELAY_SCALE=1
FORCE_PHASE=
FORCE_MOOD=
FAKE_NOW=
RNG_SEED=
DRY_RUN=0
